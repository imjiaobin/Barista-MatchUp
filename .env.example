# Neon PostgreSQL 連線字串
DATABASE_URL=

# 後台 session JWT 簽章密鑰（32+ bytes 隨機字串，例如 openssl rand -base64 32）
ADMIN_SESSION_SECRET=

# 僅 `npm run db:seed-admin` 使用，用來建立第一個後台帳號；不會在執行期讀取
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# 寄送聯絡表單通知信用的 Gmail 帳號（需開啟兩步驟驗證後產生「應用程式密碼」）
GMAIL_USER=
GMAIL_APP_PASSWORD=

# 收到新的聯絡表單詢問時，通知信要寄到哪個信箱
ADMIN_NOTIFICATION_EMAIL=

# 網站正式網址，供 sitemap/metadata 產生絕對網址使用
NEXT_PUBLIC_SITE_URL=https://pourfolio.tw
